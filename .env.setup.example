# Minimal starter configuration for a private, single-user/self-hosted instance.
# Set this to the URL at which the service will be reachable.
PORT=3232
HOST_NAME=http://localhost:3232
NODE_ENV=production
LOG_LEVEL=info
DATABASE_URI=sqlite://addon/data/db.sqlite
REDIS_URL=redis://redis:6379
# Strong random secret to protect dashboard/admin endpoints. Generate a unique value.
ADMIN_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
# Optional API keys. Add only the providers/integrations you use.
TMDB_API_KEY=
TVDB_API_KEY=
FANART_API_KEY=
RPDB_API_KEY=
MDBLIST_API_KEY=
GEMINI_API_KEY=
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
